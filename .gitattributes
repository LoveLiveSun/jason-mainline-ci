# CI 跑在 Linux 上，脚本必须是 LF。
# CRLF 会让 #!/bin/bash 变成 bad interpreter: /bin/bash^M
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.md      text eol=lf

# initramfs 的 /init 无扩展名，但同样必须 LF
initramfs/init  text eol=lf
deviceinfo      text eol=lf
modules-initfs  text eol=lf
APKBUILD        text eol=lf

# 二进制不碰
*.png binary
*.jpg binary
